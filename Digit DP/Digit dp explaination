        public class Main{
 
        static int dp[][][];
        

         static int solve(String s , int index , int tight , int count){
          if(index >= s.length()){
            return count;
          }

          if(dp[index][tight][count] != -1){
            return dp[index][tight][count];
          }

          // if in restricted mode (tight == true/1) than limit should be s.charAt(i)
          // else in non restricted mode (tight == false/0) than limit equal to 9
          int limit = tight == 1 ? s.charAt(index)-'0 : 9;


          // define answers variable
          int ans = 0;

          for(int i = 0 ; i <= limit ; i++){
          // if i is equal to 3 than add 1 in count
            int updateCount = count + (i == 3) ? 1 : 0; 

            boolean restrictionFlag = (i == s.charAt(i)-'0); // 

            // add all count in ans by using call recursion
            ans += solve(s , index+1 , (tight & restrictionFlag) , updateCount);
          }
            return dp[index][tight][count] = ans;
         }
        
